# z739_final_senior_v5.R, corrida real: predice 202109 y sube a Kaggle.
# v5 = v2 (BO por AUC, entrena 201901-202105, valida 202107) con dos cambios:
#   semillerio de 30 (las 9 de la v2 primero) y canaritos con 2.0 desvios.
# Lo lee vm/lanzar.sh A (VMs z739i-a y z739i-a2). Formato KEY=valor, sin espacios ni comillas.

GRUPO=A

# experimento nuevo: exp/WF9850_s<semilla>
EXPERIMENTO=9850

# las MISMAS 10 semillas que la v2 (9800): comparacion pareada
SEMILLAS_PIPELINE=150001,333331,600017,910009,720007,999953,850009,450007,210011,570001

FT_SEMILLERIO=20
CN_DESVIOS=2.0

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
