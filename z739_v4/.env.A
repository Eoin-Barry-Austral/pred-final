# z739_final_senior_v4.R, corrida real: predice 202109 y sube a Kaggle.
# Igual que la v3 (experimento 9900) salvo la validacion de la BO: "hacia adelante",
# un modelo por mes de validacion entrenado con todo lo anterior (1 mes de gap):
#   valida 202105 con training 201901-202103 · valida 202107 con training 201901-202105
# Lo lee vm/lanzar.sh A (VMs z739h-a y z739h-a2). Formato KEY=valor, sin espacios ni comillas.

GRUPO=A

# experimento nuevo: exp/WF9950_s<semilla>
EXPERIMENTO=9950

# las MISMAS 10 semillas que la v2 (9800) y la v3 (9900)
SEMILLAS_PIPELINE=150001,333331,600017,850009,999953,210011,450007,570001,720007,910009

BO_METRICA=ganancia
BO_ESQUEMA=adelante
BO_VALIDA=202105,202107

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
