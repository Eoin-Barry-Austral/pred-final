# z739_final_senior_v4.R, corrida real: predice 202109 y sube a Kaggle.
# Igual que la v3 (experimento 9900) salvo los meses de la BO: entrena 201901-202105 y
# valida solo en 202107 (la misma ventana que la v2, pero optimizando ganancia).
# Un solo modelo por evaluacion: mismo costo que la v3.
# Lo lee vm/lanzar.sh A (VMs z739h-a y z739h-a2). Formato KEY=valor, sin espacios ni comillas.

GRUPO=A

# experimento nuevo: exp/WF9950_s<semilla>
EXPERIMENTO=9950

# las MISMAS 10 semillas que la v2 (9800) y la v3 (9900)
SEMILLAS_PIPELINE=150001,333331,600017,850009,999953,210011,450007,570001,720007,910009

BO_METRICA=ganancia
BO_ESQUEMA=fijo
BO_VALIDA=202107

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
MAIL_TO_FILE=/dev/null

# v4: early stopping en la BO (200 arboles de paciencia, tope 2048) y final training
# con la mejor iteracion x 1.15
BO_EARLY_STOPPING=200
BO_TOPE_ITERACIONES=2048
FT_FACTOR_ITER=1.15
CN_DESVIOS=2.0
