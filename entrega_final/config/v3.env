# z739_final_senior_v3.R, corrida real: predice 202109 y sube a Kaggle.
# Igual que la v2 (experimento 9800) salvo la BO: optimiza GANANCIA medida en 4 meses.
# Lo lee vm/lanzar.sh A (VMs z739g-a y z739g-a2). Formato KEY=valor, sin espacios ni comillas.

GRUPO=A

# experimento nuevo: exp/WF9900_s<semilla>
EXPERIMENTO=9900

# las MISMAS 10 semillas que la v2 (9800), para comparar de a pares
SEMILLAS_PIPELINE=150001,333331,600017,850009,999953,210011,450007,570001,720007,910009

# BO por ganancia (promedio de los cortes 8.000 a 12.000), medida en 4 meses;
# el training de la BO va de 201901 a 202102 (1 mes de gap)
BO_METRICA=ganancia
BO_VALIDA=202104,202105,202106,202107

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
MAIL_TO_FILE=/dev/null
