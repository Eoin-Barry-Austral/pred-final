# Configuracion de z739_final_senior_v2.R (grupo A: predice 202109 y sube a Kaggle).
# Lo lee vm/lanzar.sh A y lo sube al bucket. Formato KEY=valor, sin espacios ni comillas.
# Los parametros del modelo (tendencias, random forest, canaritos, BO, semillerio)
# estan en el script, igual que en la notebook.

GRUPO=A

# carpeta de salida: exp/WF<EXPERIMENTO>_s<semilla>. Mismo numero = retoma la anterior
EXPERIMENTO=9800

# una corrida completa por semilla. La VM 1 recorre la lista en orden y la VM 2
# (vm/lanzar.sh A 2) al reves; cada semilla la corre una sola VM
SEMILLAS_PIPELINE=150001,333331,600017,850009,999953,210011,450007,570001,720007,910009

# Kaggle: 1 = sube los 9 cortes (8000 a 12000 envios) de cada semilla
KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

# rutas ADENTRO de la VM (no tocar)
BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

# mail: asi no manda (lo usa solo vm/startup.sh para avisos)
MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
MAIL_TO_FILE=/dev/null
