# z739_final_senior_v7.R: REPETICION de la semilla 570001 CON genetica (exp 9601).
# La 570001 de la v7 (exp 9600) corrio sin genetica porque arranco antes de
# aceptar las formulas. Esta corrida usa las mismas formulas aceptadas (se copia
# exp/WF9600_ga a exp/WF9601_ga antes de lanzar, asi no se vuelve a buscar).
# Lo lee vm/lanzar.sh B (VM z739k-b). Sube a Kaggle.
GRUPO=B
EXPERIMENTO=9601
SEMILLAS_PIPELINE=570001

FT_SEMILLERIO=20
CN_DESVIOS=2.0
DR_METODO=deflacion
MESES_EXCLUIR=202001,202002,202003,202004,202005,202006,202007,202008,202009,202010,202011,202012

GA_ACTIVA=1
GA_BUSQUEDA=202104,202105
GA_CONTROL=202103,202106
GA_RONDAS=3
GA_POBLACION=20
GA_GENERACIONES=10
GA_UNDERSAMPLING=0.1
GA_N_CONTROL=19
GA_SEMILLA=777
GA_HORAS_MAX=8

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
MAIL_TO_FILE=/dev/null
