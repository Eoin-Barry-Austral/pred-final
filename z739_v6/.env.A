# z739_final_senior_v6.R, corrida real: predice 202109 y sube a Kaggle.
# v6 = v2 (BO por AUC, canaritos 2.5) con semillerio de 30 (como la v5), variables nuevas
# (FE_NUEVAS) y el random forest de variables entrenado en 201907-201909.
# Lo lee vm/lanzar.sh A (VMs z739j-a y z739j-a2). Formato KEY=valor, sin espacios ni comillas.

GRUPO=A

# experimento nuevo: exp/WF9700_s<semilla>
EXPERIMENTO=9700

# las MISMAS 10 semillas que la v2 (9800): comparacion pareada
SEMILLAS_PIPELINE=150001,333331,600017,850009,999953,210011,450007,570001,720007,910009

FE_NUEVAS=1
FE_RF_MESES=201907,201908,201909
FT_SEMILLERIO=30
CN_DESVIOS=2.5

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
