# z739_final_senior_v13.R, corrida real: v2 exacta con undersampling extremo en el final training.
# Todo el dataset, semillerio 9, canaritos 2.5, sin pesos; hiperparametros = la mejor fila de la BO de la v2 de
# cada semilla con arboles x2, hojas /2, learning rate /2 y minimo por hoja /4 (exp/v13_hp, hiperparametros_v13.R)
# (exp 9800) y el final training usa solo el 5% de los CONTINUA. VMs z739q-*.
# Lo lee vm/lanzar.sh (VMs z739q-*). Formato KEY=valor, sin espacios ni comillas.

GRUPO=A
EXPERIMENTO=9050
SEMILLAS_PIPELINE=570001,210011,150001,450007,600017,720007,999953,850009,910009,333331

FT_SEMILLERIO=9
CN_DESVIOS=2.5
DR_METODO=deflacion
MESES_EXCLUIR=
CK_DESDE_EXP=
GA_ACTIVA=0
POS_PESO=1
BO_LOG_FIJO=/home/ds/buckets/b1/exp/v13_hp/BO_log_{semilla}.txt
FT_UNDERSAMPLING=0.05

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
MAIL_TO_FILE=/dev/null
