# z739_final_senior_v13.R, corrida real: v2 exacta con undersampling extremo en el final training.
# Todo el dataset, semillerio 9, canaritos 2.5, sin pesos; cada semilla reusa SU BO de la v2
# (exp 9800) y el final training usa solo el 5% de los CONTINUA. VMs z739q-*.
# Lo lee vm/lanzar.sh (VMs z739q-*). Formato KEY=valor, sin espacios ni comillas.

GRUPO=A
EXPERIMENTO=9100
SEMILLAS_PIPELINE=570001,720007,600017,999953,450007,850009,150001,910009,210011,333331

FT_SEMILLERIO=9
CN_DESVIOS=2.5
DR_METODO=deflacion
MESES_EXCLUIR=
CK_DESDE_EXP=
GA_ACTIVA=0
POS_PESO=1
BO_LOG_FIJO=/home/ds/buckets/b1/exp/WF9800_s{semilla}/BO_log.txt
FT_UNDERSAMPLING=0.05

KAGGLE_SUBIR=1
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
KAGGLE_JSON=/home/ds/buckets/b1/kaggle.json

BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

MAIL_FROM=sin-mail
MAIL_PASS_FILE=/dev/null
MAIL_TO_FILE=/dev/null
